rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          getUserData().role in ['admin', 'supervisor']));
    }
    
    function isServant() {
      return isAuthenticated() && 
        (isAdmin() || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          getUserData().role in ['servant', 'admin', 'supervisor']));
    }

    function isCanteenServant() {
      return isAuthenticated() && 
        (isAdmin() || 
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          getUserData().role in ['canteen_servant', 'admin', 'supervisor']));
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Youth Profiles
    match /youthProfiles/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isServant());
      allow create: if isAuthenticated() && (request.auth.uid == userId || isServant());
      allow update: if isAuthenticated() && (request.auth.uid == userId || isServant());
      allow delete: if isAdmin();
    }

    // Meetings (Only Service Secretary / Admin can create, update, delete)
    match /meetings/{meetingId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Attendance records
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isServant());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isServant());
      allow update, delete: if isAdmin();
    }

    // Follow-ups (Protected from youth; confidential notes restricted to Admin or author)
    match /followups/{followupId} {
      allow read: if isServant() && 
        (resource.data.isConfidential != true || isAdmin() || resource.data.servantId == request.auth.uid);
      allow create, update: if isServant();
      allow delete: if isAdmin();
    }

    // Trips (Only Service Secretary / Admin can create, update, delete)
    match /trips/{tripId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Trip Bookings
    match /tripBookings/{bookingId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isServant());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isServant());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isServant());
      allow delete: if isAdmin();
    }

    // Events / Activities (Only Service Secretary / Admin can create, update, delete)
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Announcements (Only Service Secretary / Admin can create, update, delete)
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Rewards & Canteen Products
    match /rewards/{rewardId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isCanteenServant();
    }

    // Vouchers (Secure token-based redemption)
    match /vouchers/{voucherId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isCanteenServant() || isServant());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isCanteenServant() || isAdmin();
      allow delete: if isAdmin();
    }

    // Reward Redemptions (Immutable audit log of redeemed items)
    match /rewardRedemptions/{redemptionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isCanteenServant() || isServant());
      allow create: if isCanteenServant() || isAdmin();
      allow update, delete: if false; // Immutable audit trail
    }

    match /coupons/{couponId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isServant() || isCanteenServant());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isServant());
      allow update: if isAdmin() || isCanteenServant();
      allow delete: if isAdmin();
    }

    // Point Transactions (Ledger)
    match /pointTransactions/{transactionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isServant());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isServant());
      allow update, delete: if isAdmin();
    }

    // Feedback (Allowed only if youth actually attended the meeting)
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated() && 
        (exists(/databases/$(database)/documents/attendance/$(request.resource.data.meetingId + '_' + request.auth.uid)) || isAdmin());
      allow read: if isServant();
      allow delete: if isAdmin();
    }

    // Personal Spiritual Reminders
    match /reminders/{reminderId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid) && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    // Settings
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Mystery Box Configurations
    match /mysteryBoxConfigs/{boxId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isCanteenServant();
    }

    // Mystery Box Redemptions (Audit trail)
    match /mysteryBoxRedemptions/{redemptionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isCanteenServant() || isServant());
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
