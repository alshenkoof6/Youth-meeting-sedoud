{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Church youth meeting user profile",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userCode": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "totalPoints": { "type": "number" },
        "birthDate": { "type": "string" }
      },
      "required": ["userId", "displayName", "role"]
    },
    "Voucher": {
      "title": "Voucher",
      "description": "Redeemable QR voucher for canteen rewards and mystery boxes",
      "type": "object",
      "properties": {
        "voucherId": { "type": "string" },
        "voucherCode": { "type": "string" },
        "qrToken": { "type": "string" },
        "userId": { "type": "string" },
        "rewardNameSnapshot": { "type": "string" },
        "pointsCost": { "type": "number" },
        "status": { "type": "string" },
        "source": { "type": "string" }
      },
      "required": ["voucherId", "voucherCode", "qrToken", "userId", "status"]
    },
    "MysteryBoxConfig": {
      "title": "MysteryBoxConfig",
      "description": "Configuration for Points Mystery Box and Birthday Mystery Box",
      "type": "object",
      "properties": {
        "boxId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "isActive": { "type": "boolean" },
        "costInPoints": { "type": "number" },
        "birthdayAvailabilityDays": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["boxId", "title", "isActive", "costInPoints"]
    },
    "MysteryBoxRedemption": {
      "title": "MysteryBoxRedemption",
      "description": "Immutable log of an opened mystery box",
      "type": "object",
      "properties": {
        "redemptionId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "boxId": { "type": "string" },
        "boxType": { "type": "string" },
        "costInPoints": { "type": "number" },
        "rewardId": { "type": "string" },
        "rewardName": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["redemptionId", "userId", "boxId", "rewardId", "timestamp"]
    },
    "GeneralEvent": {
      "title": "GeneralEvent",
      "description": "General calendar event created directly from Unified Calendar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "location": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "type", "title", "startDate", "startTime", "location", "createdBy", "createdAt"]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "Weekly youth meeting record",
      "type": "object",
      "properties": {
        "meetingId": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "location": { "type": "string" }
      },
      "required": ["meetingId", "title", "date", "startTime", "location"]
    },
    "ChurchEvent": {
      "title": "ChurchEvent",
      "description": "Activity, spiritual day, or event record",
      "type": "object",
      "properties": {
        "eventId": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" }
      },
      "required": ["eventId", "title", "date", "location"]
    },
    "Trip": {
      "title": "Trip",
      "description": "Church trip record",
      "type": "object",
      "properties": {
        "tripId": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "destination": { "type": "string" }
      },
      "required": ["tripId", "title", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of all youth, servants, and priests in the meeting"
    },
    "/generalEvents/{eventId}": {
      "schema": "GeneralEvent",
      "description": "Collection of general events created in Unified Calendar"
    },
    "/meetings/{meetingId}": {
      "schema": "Meeting",
      "description": "Collection of youth meetings"
    },
    "/events/{eventId}": {
      "schema": "ChurchEvent",
      "description": "Collection of church activities and events"
    },
    "/trips/{tripId}": {
      "schema": "Trip",
      "description": "Collection of church trips"
    },
    "/vouchers/{voucherId}": {
      "schema": "Voucher",
      "description": "Collection of active and redeemed vouchers"
    },
    "/mysteryBoxConfigs/{boxId}": {
      "schema": "MysteryBoxConfig",
      "description": "Configurations for points and birthday mystery boxes"
    },
    "/mysteryBoxRedemptions/{redemptionId}": {
      "schema": "MysteryBoxRedemption",
      "description": "Audit records of all mystery boxes opened by users"
    }
  }
}
